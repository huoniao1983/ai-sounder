{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AISounder",
  "version": "0.1.0",
  "identifier": "com.aisounder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AISounder",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/aisounder-engine"],
    "resources": {
      "../../assets": "assets"
    },
    "icon": ["icons/icon.ico"]
  }
}
